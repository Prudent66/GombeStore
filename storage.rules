rules_version = '2';

// Deploy with:  firebase deploy --only storage
// (Firebase console → Storage → Rules also accepts this file's contents.)
service firebase.storage {
  match /b/{bucket}/o {
    // Product images: anyone can view, only the owning vendor may write.
    match /products/{vendorId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == vendorId
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == vendorId;
    }
  }
}
