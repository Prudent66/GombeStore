rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check user roles
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isVendor() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor'; }
    function isCustomer() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer'; }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Shops Collection
    match /shops/{shopId} {
      allow read: if true; // Anyone can browse shops
      allow create: if isVendor();
      allow update, delete: if isVendor() && resource.data.ownerId == request.auth.uid || isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isVendor();
      // Signed-in users may only touch stock/isAvailable (auto-deduction at checkout)
      allow update: if isVendor() && resource.data.vendorId == request.auth.uid || isAdmin()
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'isAvailable']));
      allow delete: if isVendor() && resource.data.vendorId == request.auth.uid || isAdmin();

      // Reviews subcollection (one review per customer per product).
      // Aggregates (ratingAvg/reviewCount on the product doc) are
      // maintained by the recalculateProductRating Cloud Function.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && reviewId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.comment is string && request.resource.data.comment.size() <= 300;
        allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // Orders Collection - Enforces your business model
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid || isAdmin());
      // Any signed-in user can order, but only in their own name
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() ||
        (isVendor() && resource.data.vendorId == request.auth.uid && request.resource.data.status in ['Confirmed', 'Processing', 'Ready for Pickup', 'Out for Delivery', 'Delivered', 'Cancelled']) ||
        (isCustomer() && resource.data.customerId == request.auth.uid && request.resource.data.status == 'Cancelled');
      allow delete: if isAdmin();
    }

    // Addresses
    match /addresses/{addressId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId || isAdmin();
    }

    // Complaints & Refunds
    match /complaints/{complaintId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId || isAdmin();
    }

    // Settings (shipping fees etc.) - admin writes, signed-in users read
    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}